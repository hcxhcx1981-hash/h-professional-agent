{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project Capsule V0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "project_id", "project_name", "project_root", "allowed_skills", "allowed_tools", "memory_namespace", "artifact_workspace", "created_at"],
  "properties": {
    "version": {"const": "0.1"},
    "project_id": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"},
    "project_name": {"type": "string", "minLength": 1},
    "project_root": {"type": "string", "minLength": 1},
    "allowed_skills": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"}},
    "allowed_tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"}},
    "memory_namespace": {"type": "string", "minLength": 1},
    "artifact_workspace": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "project_purpose": {"type": "string", "minLength": 1},
    "phase": {"type": "string", "minLength": 1},
    "blocked_capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-zA-Z0-9_-]+$"}},
    "provenance": {"type": "object"}
  }
}
